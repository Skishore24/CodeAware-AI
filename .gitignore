# =========================================================
# CodeAware AI — Production Git Ignore
# =========================================================

# ---------------------------------------------------------
# Python & Virtual Environments
# ---------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.Python
env/
venv/
.venv/
ENV/
backend/venv/
backend/.venv/
*/venv/
*/.venv/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.ruff_cache/
.mypy_cache/

# ---------------------------------------------------------
# Environment & Secrets
# ---------------------------------------------------------
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key
*.cert

# ---------------------------------------------------------
# Node & Frontend Build
# ---------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.vite/
frontend/.vite/
.nx/
frontend/.nx/
.eslintcache
.oxc/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------
# Data Storage, Embeddings & Database
# ---------------------------------------------------------
*.sqlite
*.sqlite3
*.db
data/repositories/*
!data/repositories/.gitkeep
data/indexes/*
!data/indexes/.gitkeep
data/graphs/*
!data/graphs/.gitkeep
data/embeddings/*
!data/embeddings/.gitkeep
backend/data/*
!backend/data/.gitkeep

# ---------------------------------------------------------
# Workspace & Sandboxes
# ---------------------------------------------------------
workspace/cloned_repositories/*
!workspace/cloned_repositories/.gitkeep
workspace/sandbox/*
!workspace/sandbox/.gitkeep
workspace/indexes/*
!workspace/indexes/.gitkeep

# ---------------------------------------------------------
# IDE & Editors
# ---------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ---------------------------------------------------------
# Operating System & Logs
# ---------------------------------------------------------
*.log
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini