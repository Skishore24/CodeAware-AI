# =========================================================
# CodeAware AI — Git Ignore
# =========================================================

# ---------------------------------------------------------
# Python & Virtual Environments
# ---------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
backend/venv/
backend/.venv/
*/venv/
*/.venv/

# ---------------------------------------------------------
# Testing & Coverage
# ---------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# ---------------------------------------------------------
# Environment & Secrets
# ---------------------------------------------------------
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# ---------------------------------------------------------
# IDE & Editors
# ---------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ---------------------------------------------------------
# Node & Frontend
# ---------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.vite/
frontend/.vite/
.nx/
frontend/.nx/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------
# Data & Knowledge Storage
# ---------------------------------------------------------
data/repositories/*
!data/repositories/.gitkeep
data/indexes/*
!data/indexes/.gitkeep
data/graphs/*
!data/graphs/.gitkeep
data/embeddings/*
!data/embeddings/.gitkeep

# ---------------------------------------------------------
# Workspace & Cloned Repositories
# ---------------------------------------------------------
workspace/cloned_repositories/*
!workspace/cloned_repositories/.gitkeep
workspace/sandbox/*
!workspace/sandbox/.gitkeep

# ---------------------------------------------------------
# Operating System & Logs
# ---------------------------------------------------------
*.log
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini