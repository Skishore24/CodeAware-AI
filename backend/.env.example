# =============================================================
# CodeAware AI — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# GitHub Personal Access Token (for PR creation via GitHub API)
# Required scope: repo
GITHUB_TOKEN=your_github_token_here

# Directory where repositories are cloned
# Default: uses the project's /workspace directory
# CLONED_REPOSITORIES_DIR=C:/MyFiles/Project/CODEAWARE/workspace

# FastAPI host/port (used by uvicorn)
HOST=127.0.0.1
PORT=8000
