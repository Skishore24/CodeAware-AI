# ==============================================================================
# CodeAware AI — Production Environment Configuration
# ==============================================================================

# Application Environment (development, production, test)
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Server Host and Port
HOST=127.0.0.1
PORT=8000

# ==============================================================================
# MySQL Database Configuration (SQLAlchemy 2.x)
# ==============================================================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=Admin@123
MYSQL_DATABASE=codeaware_db
# Alternative direct connection string (if set, overrides individual parameters)
DATABASE_URL=mysql+pymysql://root:Admin%40123@127.0.0.1:3306/codeaware_db

# ==============================================================================
# Ollama Local LLM & Embedding Settings
# ==============================================================================
OLLAMA_BASE_URL=http://localhost:11434
# Primary reasoning & code repair model (e.g., llama3.1:8b, qwen2.5-coder:7b)
OLLAMA_MODEL=llama3.1:8b
# Fast classification / simple explanation model (e.g., llama3.2:3b)
OLLAMA_FAST_MODEL=llama3.2:3b
# Local vector embedding model (e.g., nomic-embed-text:latest)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
# Timeout in seconds for local model inference
OLLAMA_TIMEOUT_SECONDS=60

# ==============================================================================
# Authentication & JWT Security
# ==============================================================================
# Secure random string for signing JWT tokens. Never share or commit in production.
JWT_SECRET_KEY=codeaware-ai-local-first-jwt-secret-key-production-ready-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# Storage & Workspace Paths
# ==============================================================================
REPOSITORY_STORAGE_PATH=./workspace/cloned_repositories
VECTOR_STORAGE_PATH=./data/indexes
SANDBOX_STORAGE_PATH=./workspace/sandbox

# GitHub Personal Access Token (optional, for PR creation)
GITHUB_TOKEN=
